# PhishShift Backend Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./phishshift.db
DEFAULT_MODEL=logistic_regression
DEFAULT_HIGH_RISK_THRESHOLD=0.70
DEFAULT_LOW_RISK_THRESHOLD=0.40
STORE_MESSAGE_BODY_DEFAULT=false
MAX_MESSAGE_LENGTH=10000
