# MailGuard AI - Frontend Environment Configuration
# API Base URL for backend communication

# Unified Vercel Fullstack Deployment (Frontend + Backend on same domain):
# Leave empty or omit VITE_API_URL

# Separate Backend Deployment (e.g. separate Vercel Project or external host):
# VITE_API_URL=https://your-backend.vercel.app

# Local Development:
# VITE_API_URL=http://127.0.0.1:8000
